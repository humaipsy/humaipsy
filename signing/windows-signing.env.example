# Copy this file to signing/windows-signing.env and fill values.
# This local file is ignored by git.

HUMAI_SIGN_ENABLED=1
HUMAI_SIGN_PFX_PATH=C:/secure/certs/humai-codesign.pfx
HUMAI_SIGN_PFX_PASSWORD=change_me
HUMAI_SIGN_TIMESTAMP_URL=http://timestamp.digicert.com
# Optional: set SIGNTOOL_PATH as a system environment variable if signtool is not in PATH.
