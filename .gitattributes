# Normalize line endings so Linux and Windows contributors can't corrupt
# each other's scripts regardless of local core.autocrlf settings.
* text=auto eol=lf

*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.ico binary
# Raw RGBA icon buffers (assets/logo): 16,384 bytes with no header, so their colour
# depends on every byte. `text=auto` would decide them per file, and a buffer that
# happened to hold no NUL byte would be rewritten as text on checkout, silently
# shifting every pixel of the icon.
*.rgba binary
# Self-hosted webfonts (docs/fonts). `text=auto` above would otherwise have Git
# decide per file; a compressed font rewritten as text would be a corrupt font.
*.woff2 binary
